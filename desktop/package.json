{
  "name": "milesman-crm-desktop",
  "version": "1.0.0",
  "description": "Desktop app for The Miles Man CRM",
  "main": "main.js",
  "author": "The Miles Man",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.themilesman.crm",
    "productName": "Miles Man CRM",
    "files": ["main.js", "offline.html", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.business" },
    "linux": { "target": ["AppImage"], "category": "Office" }
  }
}
